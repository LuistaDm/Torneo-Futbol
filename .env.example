# PostgreSQL connection used by Prisma. Never commit a real .env file.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/futbol_compania_2?schema=public"

# Single private administration access. Keep both values long and private.
ADMIN_PASSWORD="replace-with-a-long-private-password"
ADMIN_SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
